<Page x:Class="CloudRedirect.Pages.UniversalSavesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16">
        <DockPanel LastChildFill="True">

            <!-- Page Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button Content="Scan Steam Library"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Gamepad24}"
                                   Click="ScanSteamLibrary_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Auto-Scan PC for Saves"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Click="AutoScan_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Add Preset"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Sparkle24}"
                                   Click="AddPreset_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Add Custom Game"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Click="AddCustomGame_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Universal Cloud Saves (Safe Mode)"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Zero-injection, out-of-process cloud sync &amp; versioning for games without Steam Cloud or protected by Hypervisors / Anti-Cheat."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Explanation & Safe Mode Info Card -->
            <Border DockPanel.Dock="Top"
                    Background="#14212D"
                    BorderBrush="#253E54"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                            Background="#1A344A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="#66C0F4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="How Universal Safe Mode Works"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#66C0F4" />
                        <TextBlock Text="CloudRedirect monitors the game process from the outside. When the game closes, it automatically snapshots your save folder and synchronizes it to your cloud provider. No memory hooks or DLL injections are performed, making it 100% safe with EasyAntiCheat, BattlEye, Vanguard, and Hypervisors."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty State when no games added -->
            <Border x:Name="EmptyStateBorder"
                    Visibility="Collapsed"
                    DockPanel.Dock="Top"
                    Background="#15212D"
                    BorderBrush="#263E52"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="44" Foreground="#475C73" HorizontalAlignment="Center" />
                    <TextBlock Text="No Universal Games Configured Yet"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="CloudRedirect can automatically scan your PC to find game save folders and monitor games as you play with zero configuration."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <ui:Button Content="⚡ Auto-Detect &amp; Scan Game Saves on this PC"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Click="AutoScan_Click"
                                   Padding="14,8"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Quick Add Popular Presets"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Sparkle24}"
                                   Click="AddPreset_Click"
                                   Padding="14,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Games List -->
            <ItemsControl x:Name="GamesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16222F"
                                BorderBrush="#26384C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Game Icon / Avatar -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6"
                                        Background="#1D2E40" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="22" Foreground="#66C0F4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Game Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GameName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <!-- Status Badge -->
                                        <Border Background="#182E1E" BorderBrush="#35661F" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#A4D007" />
                                        </Border>
                                        <!-- Protection Tag Badge -->
                                        <Border Background="#1A2D3E" BorderBrush="#2D4D68" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ProtectionTypeTag, Mode=OneWay}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#66C0F4" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Process & Folder Details -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Process: " FontSize="11" Foreground="#55697E" />
                                        <TextBlock Text="{Binding ProcessName, Mode=OneWay}" FontSize="11" Foreground="#C6D4DF" Margin="0,0,8,0" />
                                        <TextBlock Text="•  Path: " FontSize="11" Foreground="#55697E" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ExpandedSavePath, Mode=OneWay}" FontSize="11" Foreground="#8F98A0" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Secondary"
                                               Click="SyncNow_Click"
                                               Tag="{Binding}"
                                               Margin="0,0,6,0"
                                               Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" Foreground="#66C0F4" />
                                            <TextBlock Text="Sync Now" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Primary"
                                               Click="SaveHistory_Click"
                                               Tag="{Binding}"
                                               Margin="0,0,6,0"
                                               Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Save History" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Danger"
                                               Click="DeleteProfile_Click"
                                               Tag="{Binding}"
                                               Padding="8,6">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </DockPanel>
    </ScrollViewer>
</Page>
