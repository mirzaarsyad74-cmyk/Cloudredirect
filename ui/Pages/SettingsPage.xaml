<Page x:Class="CloudRedirect.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:CloudRedirect.Resources"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="{res:Loc Settings_Title}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Quality of Life, Danger Zone -->
                <StackPanel Grid.Column="0">

                    <!-- Quality of Life Section -->
                    <StackPanel x:Name="ExtraSection" Margin="0,0,0,16">
                        <TextBlock Text="{res:Loc Settings_Extra}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <StackPanel>
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc Settings_AutoUpdate}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{res:Loc Settings_AutoUpdate_Description}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AutoUpdateDllToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>


                            <!-- cloud_redirect-only QoL card. -->
                            <ui:CardControl x:Name="ShowNonSteamGameCard" Margin="0,0,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc Settings_ShowNonSteamGame}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{res:Loc Settings_ShowNonSteamGameHint}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ShowNonSteamGameToggle"
                                                 Checked="SyncToggle_Changed"
                                                 Unchecked="SyncToggle_Changed" />
                            </ui:CardControl>

                            <!-- Start with Windows -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Launch CloudRedirect automatically on Windows startup (minimized to system tray)."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Minimize to Tray on Close -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Minimize to Tray on Close"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Closing the window keeps CloudRedirect running in the background system tray."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="MinimizeToTrayToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>

                            <!-- Sync Notifications -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Save Sync Desktop Notifications"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Show system tray notification balloons when save backups and cloud synchronization complete."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ShowNotificationsToggle"
                                                 Checked="AppSettingsToggle_Changed"
                                                 Unchecked="AppSettingsToggle_Changed" />
                            </ui:CardControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Danger Zone Section -->
                    <TextBlock Text="{res:Loc Settings_DangerZone}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <ui:CardControl Margin="0,0,0,0">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{res:Loc Settings_ResetCacheTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{res:Loc Settings_ResetCacheDescription}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Content="{res:Loc Settings_Reset}"
                                   Appearance="Danger"
                                   Click="ResetData_Click" />
                    </ui:CardControl>
                </StackPanel>

                <!-- Right Column: Experimental Features -->
                <StackPanel Grid.Column="2" x:Name="ExperimentalSection">
                    <TextBlock Text="{res:Loc Settings_Experimental}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <StackPanel>
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_SyncAchievements}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_SyncAchievementsHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SyncAchievementsToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_SyncPlaytime}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_SyncPlaytimeHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SyncPlaytimeToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>

                        <ui:CardControl x:Name="SyncLuasCard" Margin="0,0,0,0">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{res:Loc Settings_SyncLuas}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{res:Loc Settings_SyncLuasHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SyncLuasToggle"
                                             Checked="SyncToggle_Changed"
                                             Unchecked="SyncToggle_Changed" />
                        </ui:CardControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</Page>
