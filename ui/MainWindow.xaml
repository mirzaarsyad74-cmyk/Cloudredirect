<ui:FluentWindow x:Class="CloudRedirect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CloudRedirect.Pages"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="{res:Loc MainWindow_Title}"
        Height="590" Width="960"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar x:Name="AppTitleBar" Title="{res:Loc MainWindow_TitleBar}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/steam_logo3.ico" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- Responsive Auto-Fit & Zoom Controls Pill -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0"
                    Background="#16222F" BorderBrush="#253A4E" BorderThickness="1"
                    CornerRadius="13" Padding="4,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutBtn"
                            ToolTip="Zoom Out (Ctrl + Scroll Down)"
                            Width="22" Height="22" Padding="0" Margin="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#8F98A0" Cursor="Hand" Click="ZoomOut_Click">
                        <ui:SymbolIcon Symbol="SubtractCircle20" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ZoomPercentText"
                               Text="Auto Fit"
                               ToolTip="Click to toggle Auto-Fit (No Scrolling) or Reset to 100%"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center" Margin="5,0,5,0"
                               Cursor="Hand" MouseDown="ZoomPercent_MouseDown" />
                    <Button x:Name="ZoomInBtn"
                            ToolTip="Zoom In (Ctrl + Scroll Up)"
                            Width="22" Height="22" Padding="0" Margin="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#8F98A0" Cursor="Hand" Click="ZoomIn_Click">
                        <ui:SymbolIcon Symbol="AddCircle20" FontSize="14" />
                    </Button>
                    <Button x:Name="AutoFitBtn"
                            ToolTip="Auto-Fit to Window without Scrolling"
                            Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                            Background="#1C354A" BorderThickness="0"
                            Foreground="#A4D007" Cursor="Hand" Click="AutoFit_Click">
                        <ui:SymbolIcon Symbol="FullScreenMaximize20" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#261A2B15"
                BorderBrush="#FF5C7E10"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="12,8,12,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button x:Name="UpdateReleaseNotesButton"
                                   Content="{res:Loc AppUpdate_ReleaseNotes}"
                                   Appearance="Secondary"
                                   Visibility="Collapsed"
                                   Margin="0,0,8,0"
                                   Click="UpdateReleaseNotes_Click" />
                        <ui:Button x:Name="UpdateSkipButton"
                                   Content="{res:Loc AppUpdate_Skip}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"
                                   Click="UpdateSkip_Click" />
                        <ui:Button x:Name="UpdateNowButton"
                                   Content="{res:Loc AppUpdate_UpdateNow}"
                                   Appearance="Success"
                                   Click="UpdateNow_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Text=""
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateBannerStatus"
                                   Text=""
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="UpdateChangelogScroll"
                              Visibility="Collapsed"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateChangelogText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
                <ProgressBar x:Name="UpdateProgressBar"
                             Visibility="Collapsed"
                             Minimum="0" Maximum="100" Value="0"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Steam Primary Navigation Bar (Persistent Desktop Client Header) -->
        <Border Grid.Row="2"
                Background="#131C26"
                BorderBrush="#213243"
                BorderThickness="0,1,0,1"
                Padding="16,0"
                Height="42">
            <DockPanel LastChildFill="True">
                <!-- Right Side: Global Live Sync Telemetry Badge & Quick Guide Button -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="GlobalSyncPill"
                            Background="#162332" BorderBrush="#25425F" BorderThickness="1"
                            CornerRadius="13" Padding="10,4" Margin="0,0,10,0"
                            Cursor="Hand"
                            ToolTip="Global Cloud Sync Engine — Click to view Universal Cloud Saves"
                            MouseDown="GlobalSyncPill_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GlobalSyncDot" Width="7" Height="7" Fill="#A4D007" Margin="0,0,6,0" />
                            <ui:SymbolIcon x:Name="GlobalSyncIcon" Symbol="ArrowSync20" FontSize="13"
                                           Foreground="#66C0F4" Margin="0,0,6,0" Visibility="Collapsed" />
                            <TextBlock x:Name="GlobalSyncText"
                                       Text="Cloud Ready"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A4D007"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ui:Button x:Name="QuickGuideNavBtn"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon QuestionCircle20}"
                               Content="{res:Loc Dashboard_GuideBtn}"
                               ToolTip="{res:Loc Dashboard_GuideTooltip}"
                               Padding="10,4"
                               FontSize="11.5"
                               Cursor="Hand"
                               Click="OpenQuickGuide_Click" />
                </StackPanel>

                <!-- Left Side: Steam Navigation Tabs -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <RadioButton x:Name="NavDashboardTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_Dashboard}"
                                     IsChecked="True"
                                     Click="NavTab_Click"
                                     Tag="Dashboard" />
                        <RadioButton x:Name="NavUniversalSavesTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_UniversalSaves}"
                                     Click="NavTab_Click"
                                     Tag="UniversalSaves" />
                        <RadioButton x:Name="NavAppsTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_Apps}"
                                     Click="NavTab_Click"
                                     Tag="Apps" />
                        <RadioButton x:Name="NavCloudProviderTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_CloudProvider}"
                                     Click="NavTab_Click"
                                     Tag="CloudProvider" />
                        <RadioButton x:Name="NavStatsTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_Stats}"
                                     Click="NavTab_Click"
                                     Tag="Stats" />
                        <RadioButton x:Name="NavCleanupTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_Cleanup}"
                                     Click="NavTab_Click"
                                     Tag="Cleanup" />
                        <RadioButton x:Name="NavSettingsTab"
                                     Style="{StaticResource SteamNavTabStyle}"
                                     Content="{res:Loc Nav_Settings}"
                                     Click="NavTab_Click"
                                     Tag="Settings" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area: Zero-Sidebar Clean Frame with Dynamic Auto-Fit Scale -->
        <Grid x:Name="ContentAreaHost" Grid.Row="3" ClipToBounds="True">
            <Frame x:Name="RootFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"
                   Focusable="False">
                <Frame.LayoutTransform>
                    <ScaleTransform x:Name="GuiScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                </Frame.LayoutTransform>
            </Frame>
        </Grid>
    </Grid>
</ui:FluentWindow>
