<ui:FluentWindow x:Class="CloudRedirect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CloudRedirect.Pages"
        xmlns:res="clr-namespace:CloudRedirect.Resources"
        Title="{res:Loc MainWindow_Title}"
        Height="590" Width="960"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource SteamWindowBackgroundGradient}"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{res:Loc MainWindow_TitleBar}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/steam_logo3.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#261A2B15"
                BorderBrush="#FF5C7E10"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="12,8,12,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button x:Name="UpdateReleaseNotesButton"
                                   Content="{res:Loc AppUpdate_ReleaseNotes}"
                                   Appearance="Secondary"
                                   Visibility="Collapsed"
                                   Margin="0,0,8,0"
                                   Click="UpdateReleaseNotes_Click" />
                        <ui:Button x:Name="UpdateSkipButton"
                                   Content="{res:Loc AppUpdate_Skip}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"
                                   Click="UpdateSkip_Click" />
                        <ui:Button x:Name="UpdateNowButton"
                                   Content="{res:Loc AppUpdate_UpdateNow}"
                                   Appearance="Success"
                                   Click="UpdateNow_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Text=""
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateBannerStatus"
                                   Text=""
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="UpdateChangelogScroll"
                              Visibility="Collapsed"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateChangelogText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
                <ProgressBar x:Name="UpdateProgressBar"
                             Visibility="Collapsed"
                             Minimum="0" Maximum="100" Value="0"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Top Navigation Bar (Visible when browsing sub-pages like Apps, Cloud Provider, etc.) -->
        <Border x:Name="TopNavHeader"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#17222E"
                BorderBrush="#263E52"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <DockPanel>
                <ui:Button x:Name="BackToDashboardBtn"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{res:Loc Nav_BackToDashboard}"
                           Click="BackToDashboard_Click"
                           Cursor="Hand" />
                <TextBlock x:Name="CurrentPageTitle"
                           Text=""
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Main Content Area: Zero-Sidebar Clean Frame -->
        <Frame x:Name="RootFrame"
               Grid.Row="3"
               NavigationUIVisibility="Hidden"
               Background="Transparent"
               Focusable="False" />
    </Grid>
</ui:FluentWindow>
